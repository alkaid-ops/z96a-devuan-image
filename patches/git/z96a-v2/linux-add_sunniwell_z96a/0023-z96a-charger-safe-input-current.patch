+/*
+ * Z96A: debounce AC edges. The charger INT also fires for charge-status
+ * changes, and RESET_VINDPM on every edge restarts the converter, which
+ * turns a marginal adapter into a latch-off. 300 ms lets the input settle
+ * before the limits are (re)programmed.
+ */
+#define BQ257XX_AC_DEBOUNCE_MS	300
+
+/*
+ * Z96A adaptive input-current backoff. Start at the DT maximum; only step
+ * down when the adapter keeps dropping AC_STAT in a short window, and step
+ * back up after the input has been stable for a while. A good adapter then
+ * always runs at full rate, while a marginal one settles at what it can
+ * actually supply.
+ */
+#define BQ257XX_IINDPM_STEP_UA	500000
+#define BQ257XX_IINDPM_FLOOR_UA	1000000
+#define BQ257XX_AC_WINDOW_MS	15000
+#define BQ257XX_AC_EDGE_LIMIT	3
+#define BQ257XX_AC_STABLE_MS	60000
