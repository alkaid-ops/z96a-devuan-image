+static int rk817_scale_voltage(struct rk817_charger *charger, int uv)
+{
+	if (charger->is_rk809 && charger->bat_res_down)
+		return uv * (charger->bat_res_up + charger->bat_res_down) /
+		       charger->bat_res_down;
+	return uv;
+}
