#!/bin/sh
set -u

LOG=/var/log/z96a-network-up.log
mkdir -p /run/NetworkManager 2>/dev/null || true
exec >>"$LOG" 2>&1

# Address the profile by UUID, not by its display name. Renaming the profile
# (e.g. "Z96A Wired Static" -> "Z96A Wired DHCP") must not break boot.
WIRED_UUID="5ee20e57-d34e-494f-ba17-ecdf0163b214"

for i in $(seq 1 60); do
	date -Is | tr '\n' ' '
	echo "activating wired profile $WIRED_UUID (attempt $i)"
	if command -v nmcli >/dev/null 2>&1; then
		nmcli connection reload >/dev/null 2>&1 || true
		if nmcli connection show "$WIRED_UUID" >/dev/null 2>&1; then
			nmcli connection up uuid "$WIRED_UUID" >/dev/null 2>&1 || true
		else
			echo "wired profile $WIRED_UUID missing"
		fi
		if ip -4 -o addr show dev eth0 2>/dev/null | grep -q ' inet '; then
			date -Is | tr '\n' ' '
			echo "eth0 IPv4 ready: $(ip -4 -o addr show dev eth0 | awk '{print $4}')"
			exit 0
		fi
	fi
	sleep 2
done

date -Is | tr '\n' ' '
echo "eth0 IPv4 failed after 60 attempts"
exit 1
