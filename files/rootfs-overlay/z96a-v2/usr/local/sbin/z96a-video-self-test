#!/bin/sh
set -eu
export LIBVA_DRIVER_NAME=v4l2stateless
export LIBVA_DRIVERS_PATH=/usr/lib/aarch64-linux-gnu/dri
echo "== vainfo =="
vainfo --display drm --device /dev/dri/renderD128
echo "== devices =="
ls -l /dev/video* /dev/media* /dev/video-rkvdec 2>/dev/null || true
echo "== vdec irq =="
awk '/fdf80200.video-codec/{s=0; for(i=2;i<=NF;i++) if($i ~ /^[0-9]+$/) s+=$i} END{print s+0}' /proc/interrupts
