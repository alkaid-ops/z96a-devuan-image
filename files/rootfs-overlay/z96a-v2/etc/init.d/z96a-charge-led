#!/bin/sh
### BEGIN INIT INFO
# Provides:          z96a-charge-led
# Required-Start:    $local_fs udev
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: One-shot capacity-based charging LED setup
### END INIT INFO

case "$1" in
	start)
		# One-shot only: set the initial LED state at boot.  Later
		# updates arrive through udev (99-z96a-charge-led.rules).
		# Do not daemonize and do not add a polling loop here.
		/usr/local/sbin/z96a-charge-led --once || true
		;;
	stop)
		# Nothing persistent to stop; leave the current LED state.
		;;
	restart)
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 3
		;;
esac

exit 0
