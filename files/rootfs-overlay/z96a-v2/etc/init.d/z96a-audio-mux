#!/bin/sh
### BEGIN INIT INFO
# Provides:          z96a-audio-mux
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Route RK817 playback to speakers or headphones
### END INIT INFO

DAEMON=/usr/local/bin/z96a-audio-mux
PIDFILE=/var/run/z96a-audio-mux.pid

case "${1:-}" in
	start)
		if [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
			exit 0
		fi
		"$DAEMON" >/dev/null 2>&1 &
		echo "$!" > "$PIDFILE"
		;;
	stop)
		if [ -s "$PIDFILE" ]; then
			pid=$(cat "$PIDFILE")
			kill "$pid" 2>/dev/null || true
			rm -f "$PIDFILE"
		fi
		;;
	restart|reload|force-reload)
		"$0" stop
		"$0" start
		;;
	status)
		if [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
			echo "z96a-audio-mux running"
			exit 0
		fi
		echo "z96a-audio-mux stopped"
		exit 3
		;;
	*)
		exit 2
		;;
esac

exit 0
