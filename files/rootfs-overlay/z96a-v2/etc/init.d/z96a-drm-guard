#!/bin/sh
### BEGIN INIT INFO
# Provides:          z96a-drm-guard
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: Fallback display-stack load if the DM did not do it
### END INIT INFO

PATH=/sbin:/usr/sbin:/bin:/usr/bin

case "$1" in
	start)
		(
			sleep 90
			[ -e /dev/dri/card0 ] && exit 0
			modprobe panel_edp 2>/dev/null || true
			modprobe rockchipdrm 2>/dev/null || true
		) &
		;;
	*)
		;;
esac
exit 0
