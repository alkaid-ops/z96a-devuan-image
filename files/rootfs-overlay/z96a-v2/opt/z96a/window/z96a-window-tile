#!/bin/sh
set -eu

# Z96A window tiling for Openbox/LXQt.
#
# Derived from the IceWM-era z96a-icewm-tile, which followed KWin's
# directional snap behaviour: a tile edge can be combined with another
# direction to reach a quarter, and moving past the edge of a monitor
# crosses to the adjacent monitor.  The window-manager calls are EWMH
# (xprop/wmctrl) instead of IceWM's icesh.

STATE_ROOT=${Z96A_WINDOW_TILE_STATE_DIR:-${XDG_RUNTIME_DIR:-/tmp}/z96a-window-tile-$(id -u)}
GAP_X=${Z96A_WINDOW_TILE_GAP_X:-0}
GAP_Y=${Z96A_WINDOW_TILE_GAP_Y:-0}

case "$GAP_X" in ''|*[!0-9]*) GAP_X=0 ;; esac
case "$GAP_Y" in ''|*[!0-9]*) GAP_Y=0 ;; esac

resolve_tile() {
    state=$1
    direction=$2
    case "$state:$direction" in
        normal:left|maximized:left) echo left ;;
        normal:right|maximized:right) echo right ;;
        normal:up|maximized:up) echo top ;;
        normal:down|maximized:down) echo bottom ;;
        left:left) echo left ;;
        left:right) echo right ;;
        right:left) echo left ;;
        right:right) echo right ;;
        left:up|top:left) echo top-left ;;
        left:down|bottom:left) echo bottom-left ;;
        right:up|top:right) echo top-right ;;
        right:down|bottom:right) echo bottom-right ;;
        top:up|top-left:up|top-right:up) echo maximized ;;
        top:down) echo bottom ;;
        bottom:up) echo top ;;
        bottom:down|bottom-left:down|bottom-right:down) echo minimized ;;
        top-left:left) echo top-left ;;
        top-left:right) echo top ;;
        top-left:down) echo left ;;
        top-right:right) echo top-right ;;
        top-right:left) echo top ;;
        top-right:down) echo right ;;
        bottom-left:left) echo bottom-left ;;
        bottom-left:right) echo bottom ;;
        bottom-left:up) echo left ;;
        bottom-right:right) echo bottom-right ;;
        bottom-right:left) echo bottom ;;
        bottom-right:up) echo right ;;
        *) return 2 ;;
    esac
}

if [ "${1:-}" = --resolve ]; then
    [ "$#" -eq 3 ] || exit 2
    resolve_tile "$2" "$3"
    exit
fi

action=${1:-}
case "$action" in
    left|right|up|down|maximize|minimize|restore) ;;
    *) exit 2 ;;
esac

display=${DISPLAY:-:0}
window=$(DISPLAY="$display" xdotool getactivewindow 2>/dev/null) || exit 0

read_client_geometry() {
    info=$(DISPLAY="$display" xwininfo -id "$window" 2>/dev/null) || return 1
    X=$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*Absolute upper-left X:[[:space:]]*//p')
    Y=$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*Absolute upper-left Y:[[:space:]]*//p')
    WIDTH=$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*Width:[[:space:]]*//p')
    HEIGHT=$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*Height:[[:space:]]*//p')
    case "$X:$Y:$WIDTH:$HEIGHT" in
        *[!0-9:]*|:*|*:|*::*) return 1 ;;
    esac
    [ -n "$X" ] && [ -n "$Y" ] && [ -n "$WIDTH" ] && [ -n "$HEIGHT" ]
}

read_geometry() {
    read_client_geometry || return 1
    refresh_frame_extents
    # xwininfo reports the client area relative to the root.  Track the
    # frame rectangle, which is what EWMH move/resize positions.
    frame_x=$((X - ext_left))
    frame_y=$((Y - ext_top))
    frame_w=$((WIDTH + ext_left + ext_right))
    frame_h=$((HEIGHT + ext_top + ext_bottom))
}

# Openbox restores decorations and pre-maximize geometry asynchronously.
# Poll until the client geometry and frame extents stop changing.
settle_window() {
    previous=
    attempts=0
    while [ "$attempts" -lt 30 ]; do
        read_client_geometry || return 0
        refresh_frame_extents
        current="$X:$Y:$WIDTH:$HEIGHT:$ext_left:$ext_right:$ext_top:$ext_bottom"
        if [ "$current" = "$previous" ]; then
            return 0
        fi
        previous=$current
        sleep 0.01
        attempts=$((attempts + 1))
    done
    return 0
}

refresh_frame_extents() {
    extents=$(DISPLAY="$display" xprop -id "$window" _NET_FRAME_EXTENTS 2>/dev/null |
        sed -n 's/.*= *//p' | tr ',' ' ')
    set -- $extents
    ext_left=${1:-0}
    ext_right=${2:-0}
    ext_top=${3:-0}
    ext_bottom=${4:-0}
    case "$ext_left" in ''|*[!0-9]*) ext_left=0 ;; esac
    case "$ext_right" in ''|*[!0-9]*) ext_right=0 ;; esac
    case "$ext_top" in ''|*[!0-9]*) ext_top=0 ;; esac
    case "$ext_bottom" in ''|*[!0-9]*) ext_bottom=0 ;; esac
}

# ICCCM gravity from WM_NORMAL_HINTS.  NorthWest means configure x/y are the
# frame corner; Static means they are the client corner.
refresh_window_gravity() {
    hints=$(DISPLAY="$display" xprop -id "$window" WM_NORMAL_HINTS 2>/dev/null || true)
    gravity_name=$(printf '%s\n' "$hints" |
        sed -n 's/.*window gravity:[[:space:]]*//p' | head -n 1)
    case "$gravity_name" in
        Static*) gravity=10 ;;
        NorthWest*|Northwest*) gravity=1 ;;
        NorthEast*|Northeast*) gravity=3 ;;
        SouthWest*|Southwest*) gravity=7 ;;
        SouthEast*|Southeast*) gravity=9 ;;
        North*) gravity=2 ;;
        South*) gravity=8 ;;
        West*) gravity=4 ;;
        East*) gravity=6 ;;
        Center*) gravity=5 ;;
        *) gravity=1 ;;
    esac
}

# Move/resize to an exact frame rectangle (x y width height).
move_resize_frame() {
    target_x=$1
    target_y=$2
    target_w=$3
    target_h=$4
    refresh_window_gravity
    client_w=$((target_w - ext_left - ext_right))
    client_h=$((target_h - ext_top - ext_bottom))
    [ "$client_w" -ge 1 ] || client_w=1
    [ "$client_h" -ge 1 ] || client_h=1

    # wmctrl positions with the window's ICCCM gravity: NorthWest means x/y
    # are the frame corner, Static means x/y are the client corner.  Qt/GTK
    # applications normally use Static, so adding the frame offsets is what
    # keeps the title bar on screen for them.
    send_x=$target_x
    send_y=$target_y
    case "$gravity" in
        2) send_x=$((target_x + target_w / 2)) ;;
        3) send_x=$((target_x + target_w)) ;;
        4) send_y=$((target_y + target_h / 2)) ;;
        5) send_x=$((target_x + target_w / 2)); send_y=$((target_y + target_h / 2)) ;;
        6) send_x=$((target_x + target_w)); send_y=$((target_y + target_h / 2)) ;;
        7) send_y=$((target_y + target_h)) ;;
        8) send_x=$((target_x + target_w / 2)); send_y=$((target_y + target_h)) ;;
        9) send_x=$((target_x + target_w)); send_y=$((target_y + target_h)) ;;
        10) send_x=$((target_x + ext_left)); send_y=$((target_y + ext_top)) ;;
    esac

    DISPLAY="$display" wmctrl -i -r "$window" \
        -e "0,$send_x,$send_y,$client_w,$client_h" >/dev/null 2>&1

    # Verify the result and correct once if the WM did not honour the
    # expected gravity (also catches a stale frame extent).
    settle_window
    actual_frame_x=$((X - ext_left))
    actual_frame_y=$((Y - ext_top))
    delta_x=$((target_x - actual_frame_x))
    delta_y=$((target_y - actual_frame_y))
    if [ "$delta_x" -ne 0 ] || [ "$delta_y" -ne 0 ]; then
        DISPLAY="$display" wmctrl -i -r "$window" \
            -e "0,$((send_x + delta_x)),$((send_y + delta_y)),$client_w,$client_h" >/dev/null 2>&1
    fi
}

mkdir -p "$STATE_ROOT"
chmod 700 "$STATE_ROOT"
state_file=$STATE_ROOT/$window

# Drop state left behind by windows that no longer exist.  X reuses window
# IDs, so a stale file could otherwise apply an old tile/restore geometry to
# an unrelated new window.
for entry in "$STATE_ROOT"/*; do
    [ -e "$entry" ] || continue
    case "$entry" in
        *.sig) continue ;;
    esac
    other=${entry##*/}
    [ "$other" = "$window" ] && continue
    case "$other" in
        ''|*[!0-9]*) rm -f "$entry" "$entry.sig"; continue ;;
    esac
    if ! DISPLAY="$display" xwininfo -id "$other" >/dev/null 2>&1; then
        rm -f "$entry" "$entry.sig"
    fi
done
for entry in "$STATE_ROOT"/*.sig; do
    [ -e "$entry" ] || continue
    [ -e "${entry%.sig}" ] || rm -f "$entry"
done

# The signature guards against the same X window ID being reused by a
# different client while an old state file is still on disk.
window_signature() {
    DISPLAY="$display" xprop -id "$window" \
        WM_CLASS _NET_WM_PID _NET_WM_WINDOW_TYPE 2>/dev/null |
        cksum | awk '{ print $1 }'
}

read_geometry || exit 0
state=normal
original_x=$frame_x
original_y=$frame_y
original_w=$frame_w
original_h=$frame_h
if [ -r "$state_file" ]; then
    current_signature=$(window_signature)
    saved_signature=$(cat "$state_file.sig" 2>/dev/null || true)
    saved_version=
    if [ "$saved_signature" = "$current_signature" ]; then
        IFS=' ' read -r saved_version saved_state saved_x saved_y saved_w saved_h < "$state_file" || true
    fi
    if [ "$saved_version" = v2 ]; then
        state=$saved_state
        original_x=$saved_x
        original_y=$saved_y
        original_w=$saved_w
        original_h=$saved_h
    else
        rm -f "$state_file" "$state_file.sig"
    fi
fi

write_state() {
    state_to_write=$1
    temporary=$state_file.$$
    printf 'v2 %s %s %s %s %s\n' "$state_to_write" "$original_x" "$original_y" "$original_w" "$original_h" > "$temporary"
    chmod 600 "$temporary"
    mv -f "$temporary" "$state_file"
    temporary=$state_file.sig.$$
    printf '%s\n' "$(window_signature)" > "$temporary"
    chmod 600 "$temporary"
    mv -f "$temporary" "$state_file.sig"
}

refresh_ewmh_state() {
    ewmh_state=$(DISPLAY="$display" xprop -id "$window" _NET_WM_STATE 2>/dev/null || true)
}

has_ewmh_state() {
    case ${ewmh_state:-} in
        *"_NET_WM_STATE_$1"*) return 0 ;;
    esac
    return 1
}

is_maximized() {
    has_ewmh_state MAXIMIZED_HORZ || has_ewmh_state MAXIMIZED_VERT
}

is_fully_maximized() {
    has_ewmh_state MAXIMIZED_HORZ && has_ewmh_state MAXIMIZED_VERT
}

is_fullscreen() {
    has_ewmh_state FULLSCREEN
}

unmaximize() {
    if is_maximized || is_fullscreen; then
        maximized_client_w=$WIDTH
        maximized_client_h=$HEIGHT
        # wmctrl only applies the first property of a multi-property
        # _NET_WM_STATE removal, so clear each state in its own message.
        DISPLAY="$display" wmctrl -i -r "$window" -b remove,maximized_vert >/dev/null 2>&1 || true
        DISPLAY="$display" wmctrl -i -r "$window" -b remove,maximized_horz >/dev/null 2>&1 || true
        if is_fullscreen; then
            DISPLAY="$display" wmctrl -i -r "$window" -b remove,fullscreen >/dev/null 2>&1 || true
        fi
        attempts=0
        while [ "$attempts" -lt 20 ]; do
            refresh_ewmh_state
            if ! is_maximized && ! is_fullscreen; then
                break
            fi
            sleep 0.01
            attempts=$((attempts + 1))
        done
        # The EWMH state clears before Openbox has restored the pre-maximize
        # geometry.  Wait for the client size to leave the maximized size,
        # then wait for the decorations/extents to settle.
        attempts=0
        while [ "$attempts" -lt 40 ]; do
            read_client_geometry || break
            if [ "$WIDTH" != "$maximized_client_w" ] || [ "$HEIGHT" != "$maximized_client_h" ]; then
                break
            fi
            sleep 0.01
            attempts=$((attempts + 1))
        done
        settle_window
        return 0
    fi
    refresh_frame_extents
    return 0
}

# Monitor layout, one "id x y width height" row per monitor.
monitor_rows=
build_monitors() {
    monitor_rows=
    index=0
    geometry_list=$(DISPLAY="$display" xrandr --listmonitors 2>/dev/null |
        awk 'NR > 1 { print $3 }' || true)
    if [ -n "$geometry_list" ]; then
        while IFS= read -r geometry; do
            parsed=$(printf '%s\n' "$geometry" |
                sed -n 's#^\([0-9][0-9]*\)/[0-9][0-9]*x\([0-9][0-9]*\)/[0-9][0-9]*+\([0-9][0-9]*\)+\([0-9][0-9]*\)$#\3 \4 \1 \2#p')
            [ -n "$parsed" ] || continue
            monitor_rows="$monitor_rows$index $parsed
"
            index=$((index + 1))
        done <<EOF
$geometry_list
EOF
    else
        geometry_list=$(DISPLAY="$display" xrandr --query 2>/dev/null |
            sed -n 's/^[^ ]* connected[^ ]*.* \([0-9][0-9]*\)x\([0-9][0-9]*\)+\([0-9][0-9]*\)+\([0-9][0-9]*\).*/\1 \3 \4 \2/p' || true)
        while IFS= read -r parsed; do
            [ -n "$parsed" ] || continue
            monitor_rows="$monitor_rows$index $parsed
"
            index=$((index + 1))
        done <<EOF
$geometry_list
EOF
    fi
    if [ -z "$monitor_rows" ]; then
        screen=$(DISPLAY="$display" xdotool getdisplaygeometry 2>/dev/null || true)
        set -- ${screen:-1920 1080}
        monitor_rows="0 0 0 ${1:-1920} ${2:-1080}
"
    fi
}

build_monitors
monitor_rows=$(printf '%s' "$monitor_rows" | sed '/^$/d')

first_monitor=$(printf '%s\n' "$monitor_rows" | awk 'NR == 1 { print $1 }')
first_monitor=${first_monitor:-0}

# Cache the EWMH state before choosing the monitor.
refresh_ewmh_state
center_x=$((X + WIDTH / 2))
center_y=$((Y + HEIGHT / 2))
monitor=$(printf '%s\n' "$monitor_rows" |
    awk -v cx="$center_x" -v cy="$center_y" '$2 <= cx && cx < $2 + $4 && $3 <= cy && cy < $3 + $5 { print $1; exit }')
if [ -z "$monitor" ]; then
    monitor=$first_monitor
fi

work_area() {
    workarea=$(DISPLAY="$display" xprop -root _NET_WORKAREA 2>/dev/null |
        sed -n 's/.*= *//p' | tr ',' ' ')
    set -- $workarea
    work_x=${1:-0}
    work_y=${2:-0}
    work_w=${3:-0}
    work_h=${4:-0}
    case "$work_x" in ''|*[!0-9]*) work_x=0 ;; esac
    case "$work_y" in ''|*[!0-9]*) work_y=0 ;; esac
    case "$work_w" in ''|*[!0-9]*) work_w=0 ;; esac
    case "$work_h" in ''|*[!0-9]*) work_h=0 ;; esac
    if [ "$work_w" -le 0 ] || [ "$work_h" -le 0 ]; then
        # Fall back to the bounding box of every monitor.
        set -- $(printf '%s\n' "$monitor_rows" | awk '
            NR == 1 { min_x = $2; min_y = $3 }
            {
                if ($2 < min_x) min_x = $2
                if ($3 < min_y) min_y = $3
                if ($2 + $4 > max_x) max_x = $2 + $4
                if ($3 + $5 > max_y) max_y = $3 + $5
            }
            END { print min_x, min_y, max_x - min_x, max_y - min_y }')
        work_x=${1:-0}
        work_y=${2:-0}
        work_w=${3:-$WIDTH}
        work_h=${4:-$HEIGHT}
    fi
}

get_area() {
    area_monitor=$1
    area_x=
    area_y=
    area_w=
    area_h=
    while read -r id mon_x mon_y mon_w mon_h; do
        [ -n "${id:-}" ] || continue
        if [ "$id" = "$area_monitor" ]; then
            area_x=$mon_x
            area_y=$mon_y
            area_w=$mon_w
            area_h=$mon_h
            break
        fi
    done <<EOF
$monitor_rows
EOF
    [ -n "$area_x" ] || return 1
    # Keep the panel/taskbar out of the tile.  _NET_WORKAREA is a single
    # desktop-wide rectangle, so intersect it with this monitor's rect.
    work_area
    left=$area_x
    top=$area_y
    right=$((area_x + area_w))
    bottom=$((area_y + area_h))
    [ "$work_x" -gt "$left" ] && left=$work_x
    [ "$work_y" -gt "$top" ] && top=$work_y
    [ "$((work_x + work_w))" -lt "$right" ] && right=$((work_x + work_w))
    [ "$((work_y + work_h))" -lt "$bottom" ] && bottom=$((work_y + work_h))
    if [ "$right" -gt "$left" ] && [ "$bottom" -gt "$top" ]; then
        area_x=$left
        area_y=$top
        area_w=$((right - left))
        area_h=$((bottom - top))
    fi
    [ "$area_w" -gt 0 ] && [ "$area_h" -gt 0 ]
}

find_adjacent_monitor() {
    current=$1
    direction=$2
    printf '%s\n' "$monitor_rows" | awk -v current="$current" -v direction="$direction" '
        {
            id[NR]=$1; x[NR]=$2; y[NR]=$3; w[NR]=$4; h[NR]=$5
            if ($1 == current) current_index=NR
        }
        END {
            if (!current_index) exit
            cx=x[current_index]+w[current_index]/2
            cy=y[current_index]+h[current_index]/2
            best=0
            for (i=1; i<=NR; i++) {
                if (i == current_index) continue
                if (direction == "left" || direction == "right") {
                    if (!(y[i] < y[current_index]+h[current_index] && y[i]+h[i] > y[current_index])) continue
                    candidate=x[i]+w[i]/2
                    if (direction == "left" && candidate < cx && (!best || candidate > best_center)) { best=i; best_center=candidate }
                    if (direction == "right" && candidate > cx && (!best || candidate < best_center)) { best=i; best_center=candidate }
                } else {
                    if (!(x[i] < x[current_index]+w[current_index] && x[i]+w[i] > x[current_index])) continue
                    candidate=y[i]+h[i]/2
                    if (direction == "up" && candidate < cy && (!best || candidate > best_center)) { best=i; best_center=candidate }
                    if (direction == "down" && candidate > cy && (!best || candidate < best_center)) { best=i; best_center=candidate }
                }
            }
            if (best) print id[best]
        }'
}

flip_tile_for_monitor_move() {
    tile=$1
    direction=$2
    case "$tile:$direction" in
        left:left) echo right ;;
        right:right) echo left ;;
        top:up) echo bottom ;;
        bottom:down) echo top ;;
        top-left:left) echo top-right ;;
        top-right:right) echo top-left ;;
        bottom-left:left) echo bottom-right ;;
        bottom-right:right) echo bottom-left ;;
        top-left:up) echo bottom-left ;;
        bottom-left:down) echo top-left ;;
        top-right:up) echo bottom-right ;;
        bottom-right:down) echo top-right ;;
        *) echo "$tile" ;;
    esac
}

apply_tile() {
    tile=$1
    target_monitor=$2
    get_area "$target_monitor" || return 1
    half_w=$(((area_w + 1) / 2))
    half_h=$(((area_h + 1) / 2))
    tile_x=$area_x
    tile_y=$area_y
    tile_w=$area_w
    tile_h=$area_h
    case "$tile" in
        left)
            tile_w=$((half_w - GAP_X))
            tile_h=$((area_h - GAP_Y))
            tile_x=$area_x
            tile_y=$area_y
            ;;
        right)
            tile_w=$((half_w - GAP_X))
            tile_h=$((area_h - GAP_Y))
            tile_x=$((area_x + half_w))
            tile_y=$area_y
            ;;
        top)
            tile_w=$((area_w - GAP_X))
            tile_h=$((half_h - GAP_Y))
            tile_x=$area_x
            tile_y=$area_y
            ;;
        bottom)
            tile_w=$((area_w - GAP_X))
            tile_h=$((half_h - GAP_Y))
            tile_x=$area_x
            tile_y=$((area_y + area_h - half_h))
            ;;
        top-left)
            tile_w=$((half_w - GAP_X))
            tile_h=$((half_h - GAP_Y))
            tile_x=$area_x
            tile_y=$area_y
            ;;
        top-right)
            tile_w=$((half_w - GAP_X))
            tile_h=$((half_h - GAP_Y))
            tile_x=$((area_x + half_w))
            tile_y=$area_y
            ;;
        bottom-left)
            tile_w=$((half_w - GAP_X))
            tile_h=$((half_h - GAP_Y))
            tile_x=$area_x
            tile_y=$((area_y + area_h - half_h))
            ;;
        bottom-right)
            tile_w=$((half_w - GAP_X))
            tile_h=$((half_h - GAP_Y))
            tile_x=$((area_x + half_w))
            tile_y=$((area_y + area_h - half_h))
            ;;
        *) return 2 ;;
    esac
    [ "$tile_w" -ge 1 ] || tile_w=1
    [ "$tile_h" -ge 1 ] || tile_h=1
    unmaximize
    move_resize_frame "$tile_x" "$tile_y" "$tile_w" "$tile_h" || return 1
    DISPLAY="$display" wmctrl -i -a "$window" >/dev/null 2>&1 || true
}

# KWin/Windows convention: pressing the same direction again on an
# already-snapped top or bottom tile maximizes or minimizes instead.
case "$state:$action" in
    top:up|top-left:up|top-right:up) action=maximize ;;
    bottom:down|bottom-left:down|bottom-right:down) action=minimize ;;
esac

if [ "$action" = minimize ]; then
    DISPLAY="$display" xdotool windowminimize "$window"
    exit
fi

if [ "$action" = restore ]; then
    if is_fullscreen; then
        unmaximize
        case "$state" in
            maximized) DISPLAY="$display" wmctrl -i -r "$window" -b add,maximized_vert,maximized_horz >/dev/null 2>&1 || true ;;
            left|right|top|bottom|top-left|top-right|bottom-left|bottom-right) apply_tile "$state" "$monitor" ;;
        esac
        exit
    fi
    case "$state" in
        maximized|left|right|top|bottom|top-left|top-right|bottom-left|bottom-right)
            unmaximize
            move_resize_frame "$original_x" "$original_y" "$original_w" "$original_h" || true
            DISPLAY="$display" wmctrl -i -a "$window" >/dev/null 2>&1 || true
            rm -f "$state_file" "$state_file.sig"
            exit
            ;;
    esac
    unmaximize
    exit
fi

if [ "$action" = maximize ]; then
    if [ "$state" = maximized ] || is_fully_maximized; then
        unmaximize
        move_resize_frame "$original_x" "$original_y" "$original_w" "$original_h" || true
        DISPLAY="$display" wmctrl -i -a "$window" >/dev/null 2>&1 || true
        rm -f "$state_file" "$state_file.sig"
        exit
    fi
    unmaximize
    DISPLAY="$display" wmctrl -i -r "$window" -b add,maximized_vert,maximized_horz >/dev/null 2>&1 || true
    write_state maximized
    exit
fi

# KWin clears maximize/fullscreen before applying a directional tile.
if [ "$state" = normal ] && { is_maximized || is_fullscreen; }; then
    unmaximize
    read_geometry || exit 0
    original_x=$frame_x
    original_y=$frame_y
    original_w=$frame_w
    original_h=$frame_h
    state=normal
fi
if is_maximized; then
    unmaximize
    state=normal
fi

next=$(resolve_tile "$state" "$action")
target_monitor=$monitor
if [ "$next" = "$state" ]; then
    adjacent=$(find_adjacent_monitor "$monitor" "$action")
    if [ -n "$adjacent" ]; then
        target_monitor=$adjacent
        next=$(flip_tile_for_monitor_move "$next" "$action")
    fi
fi

apply_tile "$next" "$target_monitor"
