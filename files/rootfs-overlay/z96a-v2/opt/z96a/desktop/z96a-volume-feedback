#!/bin/bash
# Play the short volume preview whenever the RK817 playback level changes.
#
# The LXQt panel and keyboard both adjust the hardware mixer directly,
# so a mixer event listener is the only place that sees every change source
# (keyboard shortcuts, panel slider, mixer applications and z96a-hotkey).

set -u

STATE_DIR=${Z96A_HOTKEY_STATE_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/z96a-hotkey}
PERSIST_DIR=${Z96A_PERSIST_DIR:-${HOME:-$STATE_DIR}/.local/state/z96a}
PREVIEW_SOUND=${Z96A_VOLUME_PREVIEW_FILE:-/usr/local/share/sounds/z96a/volume-preview.wav}
PREVIEW_INTERVAL=${Z96A_VOLUME_PREVIEW_INTERVAL:-0.05}
PREVIEW_PIDFILE=$STATE_DIR/volume-preview.pid

[ "${Z96A_VOLUME_PREVIEW:-1}" != "0" ] || exit 0
[ -r "$PREVIEW_SOUND" ] || exit 0
command -v amixer >/dev/null 2>&1 || exit 0
command -v aplay >/dev/null 2>&1 || exit 0

mkdir -p "$STATE_DIR" 2>/dev/null || exit 0
chmod 700 "$STATE_DIR" 2>/dev/null || true
mkdir -p "$PERSIST_DIR" 2>/dev/null || true
chmod 700 "$PERSIST_DIR" 2>/dev/null || true

debug() {
	[ "${Z96A_DEBUG:-0}" = "1" ] || return 0
	printf '%s %s\n' "$(date '+%H:%M:%S')" "$*" >> "$STATE_DIR/volume-feedback.log"
}

card=$(awk '/\[rk817ext[[:space:]]*\]/ { gsub(/^[[:space:]]+/, "", $1); print $1; exit }' /proc/asound/cards 2>/dev/null)
[ -n "$card" ] || exit 0

level() {
	amixer -c "$card" sget Master 2>/dev/null |
		sed -n 's/.*Playback \([0-9][0-9]*\) \[.*/\1/p' |
		head -n 1
}

save_volume_persistent() {
	level=$1
	percent=$(/usr/local/bin/z96a-hotkey volume-info 2>/dev/null | awk '{print $1}')
	[ -n "$percent" ] || percent=50
	printf '%s %s\n' "$level" "$percent" > "$PERSIST_DIR/volume-level.tmp.$$" 2>/dev/null || return 0
	mv -f "$PERSIST_DIR/volume-level.tmp.$$" "$PERSIST_DIR/volume-level" 2>/dev/null || true
}

signal_volume() {
	signal=$STATE_DIR/volume-changed
	previous=$(cat "$signal" 2>/dev/null || printf '0')
	case "$previous" in
		''|*[!0-9]*) previous=0 ;;
	esac
	printf '%s\n' "$((previous + 1))" > "$signal.tmp.$$"
	mv -f "$signal.tmp.$$" "$signal"
}

kill_preview() {
	if [ -r "$PREVIEW_PIDFILE" ]; then
		pid=$(sed -n '1p' "$PREVIEW_PIDFILE" 2>/dev/null || true)
		case "$pid" in
			''|*[!0-9]*) ;;
			*) kill "$pid" 2>/dev/null || true ;;
		esac
	fi
}

play_preview() {
	kill_preview
	# Double-fork the player so it is reparented away from this daemon:
	# a dead player is reaped by init instead of lingering as a zombie
	# that the event loop would never wait for.
	(
		aplay -q -D default "$PREVIEW_SOUND" >/dev/null 2>&1 &
		printf '%s\n' "$!" > "$PREVIEW_PIDFILE"
	) &
	wait "$!" 2>/dev/null || true
	debug "preview level=$1"
}

workdir=
amixer_pid=
cleanup() {
	[ -n "${amixer_pid:-}" ] && kill "$amixer_pid" 2>/dev/null || true
	kill_preview
	[ -n "${workdir:-}" ] && rm -rf "$workdir"
}

trap cleanup EXIT
trap 'cleanup; exit 0' INT TERM HUP

workdir=$(mktemp -d "$STATE_DIR/volume-feedback.XXXXXX") || exit 0
fifo=$workdir/events
mkfifo "$fifo" || exit 0

last_level=
while :; do
	if command -v stdbuf >/dev/null 2>&1; then
		stdbuf -oL amixer -c "$card" events > "$fifo" 2>/dev/null &
	else
		amixer -c "$card" events > "$fifo" 2>/dev/null &
	fi
	amixer_pid=$!

	while :; do
		if IFS= read -r -t 1 line; then
			:
		else
			status=$?
			# 1 = EOF: amixer died, restart it.  >128 = timeout: check for signals.
			[ "$status" -gt 128 ] && continue
			break
		fi

		case "$line" in
			*"event value:"*"name='Master Playback Volume'"*) ;;
			*) continue ;;
		esac

		sleep "$PREVIEW_INTERVAL" 2>/dev/null || sleep 0.05
		current=$(level)
		[ -n "$current" ] || continue
		if [ "$current" -eq 0 ]; then
			if [ "${last_level:-}" != "0" ]; then
				signal_volume
			fi
			debug "muted level=0"
			last_level=0
			continue
		fi
		[ "$current" = "$last_level" ] && continue
		last_level=$current
		signal_volume
		save_volume_persistent "$current"
		play_preview "$current"
	done < "$fifo"

	wait "$amixer_pid" 2>/dev/null || true
	amixer_pid=
	sleep 1
done
