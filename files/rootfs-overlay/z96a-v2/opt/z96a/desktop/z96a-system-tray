#!/usr/bin/python3
"""Shared GTK tray controls for RK817 volume and display brightness."""

from __future__ import annotations

import fcntl
import configparser
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk


HOTKEY = "/usr/local/bin/z96a-hotkey"
BRIGHTNESS_DEVICE = os.environ.get("Z96A_BRIGHTNESS_DEVICE", "backlight")
PERCENT_RE = re.compile(r"\[\s*(\d+)%\]")
DEBUG = os.environ.get("Z96A_DEBUG", "0") == "1"
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
SIGNAL_DIR = Path(os.environ.get("Z96A_HOTKEY_STATE_DIR", str(RUNTIME_DIR / "z96a-hotkey")))
BRIGHTNESS_SIGNAL = SIGNAL_DIR / "brightness-changed"
VOLUME_SIGNAL = SIGNAL_DIR / "volume-changed"
SYSTEM_POLICY = Path("/etc/z96a/power-policy.conf")
USER_POLICY = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "z96a/power-policy.conf"
POLICY_BINARY = "/usr/local/sbin/z96a-power-policy"
POLICY_DEFAULTS = {
    "ACScreenOffTimeout": 600, "BatteryScreenOffTimeout": 300,
    "ACSuspendTimeout": 1800, "BatterySuspendTimeout": 900,
    "ACPoweroffTimeout": 3600, "BatteryPoweroffTimeout": 1800,
}


def debug(message: str) -> None:
    if DEBUG:
        print(f"z96a-system-tray: {message}", file=sys.stderr, flush=True)


def run_quiet(argv: list[str], timeout: float = 2.0) -> subprocess.CompletedProcess[str] | None:
    try:
        return subprocess.run(argv, check=False, text=True, capture_output=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None


def brightness_percent() -> int | None:
    current = run_quiet(["brightnessctl", f"--device={BRIGHTNESS_DEVICE}", "get"])
    maximum = run_quiet(["brightnessctl", f"--device={BRIGHTNESS_DEVICE}", "max"])
    if current is None or maximum is None or current.returncode or maximum.returncode:
        return None
    try:
        cur, top = int(current.stdout.strip()), int(maximum.stdout.strip())
    except ValueError:
        return None
    return max(1, min(100, round(cur * 100 / top))) if top > 0 else None


def volume_state() -> tuple[int | None, bool]:
    result = run_quiet([HOTKEY, "volume-info"])
    if result is None or result.returncode:
        return None, False
    try:
        percent, muted = (int(value) for value in result.stdout.split())
    except ValueError:
        return None, False
    return percent, muted == 1


BATTERY_DEVICE = os.environ.get("Z96A_BATTERY_DEVICE", "/sys/class/power_supply/bq257xx-fgu")
BATTERY_TEMP_ZONE = os.environ.get("Z96A_BATTERY_TEMP_ZONE", "/sys/class/thermal/thermal_zone2/temp")
CPU_TEMP_ZONE = os.environ.get("Z96A_CPU_TEMP_ZONE", "/sys/class/thermal/thermal_zone0/temp")
BATTERY_ICON_FILE = SIGNAL_DIR / "battery-status.svg"
BATTERY_ICON_SIZE = (32, 32)


def read_text(path: str) -> str | None:
    try:
        return Path(path).read_text(encoding="ascii").strip()
    except OSError:
        return None


def read_int(path: str) -> int | None:
    value = read_text(path)
    if value is None:
        return None
    try:
        return int(value)
    except ValueError:
        return None


def battery_state() -> dict[str, object] | None:
    if not Path(BATTERY_DEVICE).is_dir():
        return None
    percent = read_int(BATTERY_DEVICE + "/capacity")
    if percent is None:
        return None
    battery_temp = read_int(BATTERY_TEMP_ZONE)
    cpu_temp = read_int(CPU_TEMP_ZONE)
    return {
        "percent": max(0, min(100, percent)),
        "status": read_text(BATTERY_DEVICE + "/status") or "",
        "battery_temp": None if battery_temp is None else battery_temp / 1000.0,
        "cpu_temp": None if cpu_temp is None else cpu_temp / 1000.0,
    }


def battery_status_text(status: str) -> str:
    return {
        "Charging": "充电中",
        "Discharging": "放电中",
        "Full": "已充满",
        "Not charging": "未充电",
    }.get(status, status or "未知")


def battery_svg(percent: int) -> bytes:
    width, height = BATTERY_ICON_SIZE
    body_x, body_y, body_w, body_h = 7, 3, 18, 11
    if percent > 60:
        color = "#4caf50"
    elif percent > 20:
        color = "#ff9800"
    else:
        color = "#f44336"
    fill_w = round((body_w - 4) * percent / 100)
    parts = [
        '<svg xmlns="http://www.w3.org/2000/svg" width="' + str(width) + '" height="' + str(height) + '">',
        '<rect x="' + str(body_x) + '" y="' + str(body_y) + '" width="' + str(body_w) + '" height="' + str(body_h) + '" rx="2" ry="2" fill="none" stroke="#ffffff" stroke-width="1.4"/>',
        '<rect x="' + str(body_x + body_w) + '" y="' + str(body_y + 3) + '" width="2" height="' + str(body_h - 6) + '" rx="1" fill="#ffffff"/>',
        '<rect x="' + str(body_x + 2) + '" y="' + str(body_y + 2) + '" width="' + str(fill_w) + '" height="' + str(body_h - 4) + '" rx="1" fill="' + color + '"/>',
        '<text x="16" y="28" text-anchor="middle" font-family="Noto Sans CJK SC, sans-serif" font-size="12" font-weight="bold" fill="#ffffff">' + str(percent) + '%</text>',
        '</svg>',
    ]
    return ''.join(parts).encode()

def load_policy() -> tuple[dict[str, int], str, bool]:
    config = configparser.ConfigParser(interpolation=None)
    config.optionxform = str
    for path in (SYSTEM_POLICY, USER_POLICY):
        try:
            with path.open(encoding="utf-8") as source:
                config.read_file(source)
        except FileNotFoundError:
            continue
    section = config["Policy"] if config.has_section("Policy") else {}
    values = {key: int(section.get(key, default)) for key, default in POLICY_DEFAULTS.items()}
    action = section.get("AutoAction")
    if action is None:
        action = "suspend" if section.get("AutoSuspendEnabled", "false").lower() == "true" else "none"
    if action not in ("none", "suspend", "poweroff"):
        raise ValueError("自动电源操作配置无效")
    for key, value in values.items():
        if value > 86400 or value < (0 if "ScreenOff" in key else 1):
            raise ValueError(f"{key} 超出范围")
    critical_shutdown = section.get("CriticalShutdownEnabled", "true").lower() == "true"
    return values, action, critical_shutdown


def save_policy(values: dict[str, int], action: str, critical_shutdown: bool) -> None:
    USER_POLICY.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp_path = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=USER_POLICY.parent,
                                         prefix=".power-policy-", delete=False) as output:
            tmp_path = Path(output.name)
            output.write("[Policy]\n")
            for key in POLICY_DEFAULTS:
                output.write(f"{key}={values[key]}\n")
            output.write(f"AutoAction={action}\n")
            output.write(f"CriticalShutdownEnabled={'true' if critical_shutdown else 'false'}\n")
            output.flush()
            os.fsync(output.fileno())
        result = run_quiet([POLICY_BINARY, "--check-config", "--user-config", str(tmp_path)], timeout=5)
        if result is None or result.returncode:
            raise ValueError(result.stderr.strip() if result else "电源策略校验不可用")
        os.replace(tmp_path, USER_POLICY)
    finally:
        if tmp_path is not None:
            tmp_path.unlink(missing_ok=True)


class PowerSettings(Gtk.Dialog):
    def __init__(self, parent: Gtk.Window) -> None:
        super().__init__(title="电源设置", transient_for=parent, flags=0)
        self.add_button("取消", Gtk.ResponseType.CANCEL)
        self.add_button("应用", Gtk.ResponseType.OK)
        self.set_resizable(False)
        values, action, critical_shutdown = load_policy()
        area = self.get_content_area()
        area.set_border_width(12)
        area.set_spacing(8)
        grid = Gtk.Grid(column_spacing=12, row_spacing=8)
        grid.attach(Gtk.Label(label="时间（分钟）", xalign=0), 0, 0, 1, 1)
        grid.attach(Gtk.Label(label="交流电"), 1, 0, 1, 1)
        grid.attach(Gtk.Label(label="电池"), 2, 0, 1, 1)
        self.spins: dict[str, Gtk.SpinButton] = {}
        for row, (title, suffix) in enumerate((("关闭屏幕（0 为不关闭）", "ScreenOffTimeout"),
                                                ("自动挂起", "SuspendTimeout"),
                                                ("空闲关机", "PoweroffTimeout")), 1):
            grid.attach(Gtk.Label(label=title, xalign=0), 0, row, 1, 1)
            for column, prefix in enumerate(("AC", "Battery"), 1):
                key = prefix + suffix
                spin = Gtk.SpinButton.new_with_range(0 if row == 1 else 1, 1440, 1)
                spin.set_value(values[key] / 60)
                self.spins[key] = spin
                grid.attach(spin, column, row, 1, 1)
        area.pack_start(grid, False, False, 0)
        self.suspend = Gtk.CheckButton(label="启用自动挂起")
        self.poweroff = Gtk.CheckButton(label="启用空闲自动关机")
        self.suspend.set_active(action == "suspend")
        self.poweroff.set_active(action == "poweroff")
        self.suspend.connect("toggled", self.exclusive, self.poweroff)
        self.poweroff.connect("toggled", self.exclusive, self.suspend)
        area.pack_start(self.suspend, False, False, 0)
        area.pack_start(self.poweroff, False, False, 0)
        self.critical_shutdown = Gtk.CheckButton(label="严重低电量时自动关机")
        self.critical_shutdown.set_active(critical_shutdown)
        area.pack_start(self.critical_shutdown, False, False, 0)
        warning = Gtk.Label(label="关闭此项后仍显示低电量告警，但设备可能在电池耗尽时断电。", xalign=0)
        warning.set_line_wrap(True)
        area.pack_start(warning, False, False, 0)
        self.show_all()

    def exclusive(self, active: Gtk.CheckButton, other: Gtk.CheckButton) -> None:
        if active.get_active():
            other.set_active(False)

    def apply(self) -> None:
        values = {key: spin.get_value_as_int() * 60 for key, spin in self.spins.items()}
        action = "suspend" if self.suspend.get_active() else "poweroff" if self.poweroff.get_active() else "none"
        save_policy(values, action, self.critical_shutdown.get_active())


class SystemTray:
    def __init__(self, osd_mode: bool = False) -> None:
        self.osd_mode = osd_mode
        self.hide_source: int | None = None
        volume, self.volume_muted = volume_state()
        self.values = {"volume": volume, "brightness": brightness_percent()}
        self.brightness_signal_mtime = self.brightness_signal_stamp()
        self.volume_signal_mtime = self.brightness_signal_stamp(VOLUME_SIGNAL)
        self.active = "brightness"
        self.updating_scale = False
        self.focus_check: int | None = None
        self.settings_open = False
        self.window = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        self.window.set_title("系统调节")
        self.window.set_decorated(False)
        self.window.set_resizable(False)
        self.window.set_skip_taskbar_hint(True)
        self.window.set_skip_pager_hint(True)
        self.window.set_keep_above(True)
        self.window.set_accept_focus(not osd_mode)
        self.window.set_focus_on_map(not osd_mode)
        self.window.set_border_width(8)
        self.window.set_default_size(300, 170)
        self.window.connect("key-press-event", self.on_key_press)
        self.window.connect("focus-out-event", self.on_focus_out)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_size_request(280, -1)
        self.labels: dict[str, Gtk.Label] = {}
        self.scales: dict[str, Gtk.Scale] = {}
        for key in ("volume", "brightness"):
            label = Gtk.Label(xalign=0)
            scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0 if key == "volume" else 5, 100, 1)
            scale.set_draw_value(False)
            scale.set_size_request(280, -1)
            scale.connect("value-changed", self.on_scale_changed, key)
            self.labels[key] = label
            self.scales[key] = scale
            box.pack_start(label, False, False, 0)
            box.pack_start(scale, False, False, 0)
        if not osd_mode:
            settings = Gtk.Button(label="电源设置")
            settings.connect("clicked", self.show_power_settings)
            box.pack_start(settings, False, False, 0)
        self.window.add(box)

        self.icons = {}
        self.battery_icon: Gtk.StatusIcon | None = None
        if Path(BATTERY_DEVICE).is_dir():
            self.battery_icon = Gtk.StatusIcon()
            self.battery_icon.set_has_tooltip(True)
            self.battery_icon.connect("activate", self.on_battery_activate)
            self.battery_icon.set_visible(True)
            self.update_battery()
        if not osd_mode:
            self.volume_icon = Gtk.StatusIcon()
            self.volume_icon.set_from_icon_name("audio-volume-high-symbolic")
            self.brightness_icon = Gtk.StatusIcon()
            self.brightness_icon.set_from_icon_name("display-brightness-symbolic")
            self.icons = {"volume": self.volume_icon, "brightness": self.brightness_icon}
            for key, icon in self.icons.items():
                icon.set_visible(True)
                icon.set_has_tooltip(False)
                icon.connect("activate", self.toggle_popup, key)
                icon.connect("popup-menu", self.show_menu, key)
        self.refresh()

    def on_battery_activate(self, _icon: Gtk.StatusIcon) -> None:
        subprocess.Popen(["lxqt-config-powermanagement"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def update_battery(self) -> bool:
        if self.battery_icon is None:
            return True
        state = battery_state()
        if state is None:
            self.battery_icon.set_visible(False)
            return True
        percent = int(state["percent"])
        parts = ["电池 " + str(percent) + "%", battery_status_text(str(state["status"]))]
        if state["battery_temp"] is not None:
            parts.append("电池温度 {:.0f}°C".format(state["battery_temp"]))
        if state["cpu_temp"] is not None:
            parts.append("CPU {:.0f}°C".format(state["cpu_temp"]))
        try:
            BATTERY_ICON_FILE.parent.mkdir(parents=True, exist_ok=True)
            temporary = BATTERY_ICON_FILE.with_suffix(".tmp")
            temporary.write_bytes(battery_svg(percent))
            temporary.replace(BATTERY_ICON_FILE)
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                str(BATTERY_ICON_FILE), *BATTERY_ICON_SIZE, True)
            self.battery_icon.set_from_pixbuf(pixbuf)
        except (OSError, GLib.Error):
            self.battery_icon.set_from_icon_name("battery-good")
        tooltip = " · ".join(parts)
        self.battery_icon.set_tooltip_text(tooltip)
        self.battery_icon.set_title(tooltip)
        return True

    def refresh(self) -> bool:
        # Update widgets from the cached values only.  Hardware is read on the
        # mixer/backlight signals, not by a periodic timer, so the tray does not
        # spawn amixer/brightnessctl every second.
        volume = self.values.get("volume")
        brightness = self.values.get("brightness")
        if volume is not None and not self.osd_mode:
            self.volume_icon.set_from_icon_name(
                "audio-volume-muted-symbolic" if self.volume_muted else
                "audio-volume-low-symbolic" if volume < 34 else
                "audio-volume-medium-symbolic" if volume < 67 else "audio-volume-high-symbolic"
            )
            self.volume_icon.set_tooltip_text(f"音量 {volume}%")
        if brightness is not None and not self.osd_mode:
            self.brightness_icon.set_tooltip_text(f"屏幕亮度 {brightness}%")
        if self.window.get_visible():
            for key, value in self.values.items():
                if value is not None:
                    self.updating_scale = True
                    self.scales[key].set_value(value)
                    self.updating_scale = False
                    self.update_label(key, value)
        return True

    def update_label(self, key: str, value: int) -> None:
        self.labels[key].set_text(f"{'音量' if key == 'volume' else '屏幕亮度'} {value}%")

    def apply_value(self, key: str, value: int) -> None:
        command = [HOTKEY, "volume-set", str(value)] if key == "volume" else [
            HOTKEY, "brightness-set", str(max(5, value))
        ]
        result = run_quiet(command, timeout=3.0)
        if result is None or result.returncode:
            detail = result.stderr.strip() if result is not None else "命令执行超时或不可用"
            run_quiet(["notify-send", "调节失败", detail or "无法应用设置"])
            return
        self.values[key] = value

    def on_scale_changed(self, scale: Gtk.Scale, key: str) -> None:
        if self.updating_scale:
            return
        value = int(round(scale.get_value()))
        self.active = key
        self.update_label(key, value)
        self.apply_value(key, value)

    def show_power_settings(self, _button: Gtk.Button) -> None:
        try:
            dialog = PowerSettings(self.window)
        except (OSError, ValueError, configparser.Error) as exc:
            run_quiet(["notify-send", "无法读取电源设置", str(exc)])
            return
        self.settings_open = True
        try:
            while dialog.run() == Gtk.ResponseType.OK:
                try:
                    dialog.apply()
                except (OSError, ValueError) as exc:
                    error = Gtk.MessageDialog(transient_for=dialog, modal=True,
                                              message_type=Gtk.MessageType.ERROR,
                                              buttons=Gtk.ButtonsType.CLOSE, text="无法保存电源设置")
                    error.format_secondary_text(str(exc))
                    error.run()
                    error.destroy()
                    continue
                break
        finally:
            self.settings_open = False
            dialog.destroy()

    def toggle_popup(self, _icon: Gtk.StatusIcon, key: str) -> None:
        if self.window.get_visible() and self.active == key:
            self.window.hide()
            return
        self.show_popup(key)

    def show_popup(self, key: str) -> None:
        self.active = key
        self.refresh()
        was_visible = self.window.get_visible()
        for name in self.scales:
            value = self.values[name]
            value = value if value is not None else (50 if name == "volume" else 100)
            self.updating_scale = True
            self.scales[name].set_value(value)
            self.updating_scale = False
            self.update_label(name, value)
        self.window.show_all()
        if self.osd_mode:
            self.position_popup(None)
            if self.hide_source is not None:
                GLib.source_remove(self.hide_source)
            self.hide_source = GLib.timeout_add(1200, self.hide_popup)
        else:
            self.position_popup(self.icons[key])
            if not was_visible:
                self.window.present()
                GLib.timeout_add(20, lambda: (self.scales[key].grab_focus(), False)[1])

    def hide_popup(self) -> bool:
        self.hide_source = None
        self.window.hide()
        return False

    def brightness_signal_stamp(self, path: Path = BRIGHTNESS_SIGNAL) -> int | None:
        try:
            return int(path.read_text(encoding="ascii").strip())
        except (OSError, ValueError):
            return None

    def poll_brightness_signal(self) -> bool:
        stamp = self.brightness_signal_stamp()
        if stamp is None or stamp == self.brightness_signal_mtime:
            return True
        self.brightness_signal_mtime = stamp
        current = brightness_percent()
        if current is not None:
            self.values["brightness"] = current
            self.refresh()
            self.show_popup("brightness")
        return True

    def position_popup(self, icon: Gtk.StatusIcon | None) -> None:
        _minimum, natural = self.window.get_preferred_size()
        height = max(170, natural.height)
        self.window.resize(300, height)
        if icon is None:
            screen = Gdk.Screen.get_default()
            x = max(0, (screen.get_width() - 300) // 2)
            self.window.move(x, 80)
            return
        geometry = icon.get_geometry()
        if not geometry:
            return
        if len(geometry) == 4:
            ok, _screen, area, _orientation = geometry
        else:
            ok, area, _orientation = geometry
        if ok:
            x = max(0, area.x + area.width // 2 - 150)
            self.window.move(x, max(0, area.y - height - 8))

    def on_focus_out(self, _window: Gtk.Window, _event: object) -> bool:
        if self.focus_check is not None:
            GLib.source_remove(self.focus_check)
        self.focus_check = GLib.timeout_add(150, self.hide_if_unfocused)
        return False

    def hide_if_unfocused(self) -> bool:
        self.focus_check = None
        if not self.settings_open and self.window.get_visible() and not self.window.has_toplevel_focus():
            debug("focus left popup")
            self.window.hide()
        return False

    def on_key_press(self, _window: Gtk.Window, event: object) -> bool:
        if getattr(event, "keyval", None) == 65307:
            self.window.hide()
            return True
        return False

    def show_menu(self, icon: Gtk.StatusIcon, button: int, activate_time: int, key: str) -> None:
        menu = Gtk.Menu()
        title = Gtk.MenuItem(label=("音量" if key == "volume" else "屏幕亮度") + "手动调节")
        title.set_sensitive(False)
        menu.append(title)
        item = Gtk.MenuItem(label="打开调节栏")
        item.connect("activate", lambda _item, k=key: self.menu_action(k, "open"))
        menu.append(item)
        menu.show_all()
        menu.popup(None, None, Gtk.StatusIcon.position_menu, icon, button, activate_time)

    def menu_action(self, key: str, action: str) -> None:
        if action == "open":
            self.toggle_popup(self.icons[key], key)

    def poll_volume(self) -> bool:
        # The volume listener writes volume-changed after each mixer change.
        # Read amixer only when that signal changes; a periodic hardware poll
        # would spawn several amixer processes per second.
        stamp = self.brightness_signal_stamp(VOLUME_SIGNAL)
        if stamp is None or stamp == self.volume_signal_mtime:
            return True
        self.volume_signal_mtime = stamp
        current, self.volume_muted = volume_state()
        if current is not None:
            self.values["volume"] = current
            self.refresh()
            self.show_popup("volume")
        return True


def acquire_lock() -> object | None:
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
    runtime.mkdir(parents=True, exist_ok=True)
    handle = (runtime / f"z96a-system-tray-{os.getuid()}.lock").open("w", encoding="ascii")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        handle.write(f"{os.getpid()}\n")
        handle.flush()
    except BlockingIOError:
        handle.close()
        return None
    return handle


def main() -> int:
    lock = acquire_lock()
    if lock is None:
        return 0
    app = SystemTray(osd_mode=("--osd" in sys.argv or os.environ.get("Z96A_TRAY_OSD") == "1"))
    GLib.timeout_add_seconds(1, app.refresh)
    GLib.timeout_add(250, app.poll_volume)
    GLib.timeout_add(250, app.poll_brightness_signal)
    GLib.timeout_add_seconds(30, app.update_battery)
    Gtk.main()
    del lock
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
