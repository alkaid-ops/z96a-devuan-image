#!/bin/sh
PREREQ="udev"
prereqs() { echo "$PREREQ"; }
case "$1" in
 prereqs) prereqs; exit 0;;
esac
. /usr/share/initramfs-tools/hook-functions

copy_exec /usr/sbin/plymouthd
copy_exec /usr/bin/plymouth

# splash plugins + DRM / framebuffer renderers
for f in /usr/lib/aarch64-linux-gnu/plymouth/*.so \
         /usr/lib/aarch64-linux-gnu/plymouth/renderers/*.so; do
	[ -f "$f" ] && copy_exec "$f"
done

mkdir -p "$DESTDIR/usr/share/plymouth/themes"
cp -a /usr/share/plymouth/themes/alkaid "$DESTDIR/usr/share/plymouth/themes/"
# the theme dir also holds the fb0 paint blobs used later by slim; the
# initramfs only needs the frame sequence and the script
rm -f "$DESTDIR/usr/share/plymouth/themes/alkaid"/*.bin.gz

mkdir -p "$DESTDIR/etc/plymouth"
cp /etc/plymouth/plymouthd.conf "$DESTDIR/etc/plymouth/"

# The DRM stack must be available in the initramfs; the rootfs deferral
# blacklist only makes sense for the no-initrd boot path.
rm -f "$DESTDIR/usr/lib/modprobe.d/z96a-defer-drm.conf"
