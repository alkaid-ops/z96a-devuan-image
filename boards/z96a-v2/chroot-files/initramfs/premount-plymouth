#!/bin/sh

# Z96A: start Plymouth as early as possible, from the initramfs.
#
# The stock init-premount/plymouth starts plymouthd before the display
# stack is ready: on this board the first --show-splash then fails and the
# animation only appears much later.  This override
#   1. waits for the DRM framebuffer /dev/fb0 (the module list in the
#      initrd loads panel-edp / analogix_dp / rockchipdrm),
#   2. repaints the boot logo into /dev/fb0, because the DRM modeset
#      clears the scanout buffer and would otherwise show black until
#      plymouthd takes over,
#   3. starts plymouthd and shows the animation before the root fs is
#      even mounted.

PREREQ="udev"

prereqs()
{
	echo "${PREREQ}"
}

case ${1} in
	prereqs)
		prereqs
		exit 0
		;;
esac

SPLASH="true"

for ARGUMENT in $(cat /proc/cmdline)
do
	case "${ARGUMENT}" in
		splash*)
			SPLASH="true"
			;;
		nosplash*|plymouth.enable=0)
			SPLASH="false"
			;;
	esac
done

if [ "${SPLASH}" = "true" ]
then
	mkdir -m 0755 /run/plymouth
	echo "Z96A $(cut -d" " -f1 /proc/uptime) entry" >> /run/initramfs/z96a-anim.log

	# wait for the DRM framebuffer: /dev/fb0 is a devtmpfs node created by
	# the kernel as soon as the module list brings up the display stack
	# (udev's by-path symlink, in contrast, can lag several seconds here)
	i=0
	while [ "$i" -lt 20 ]; do
		[ -e /dev/fb0 ] && break
		sleep 0.1
		i=$((i + 1))
	done

	# the DRM modeset cleared the scanout buffer: paint the boot logo back
	# so nothing black shows while plymouthd initialises
	if command -v zcat >/dev/null 2>&1 &&
	   [ -r /usr/share/plymouth/themes/alkaid/logo-bgra.bin.gz ]; then
		zcat /usr/share/plymouth/themes/alkaid/logo-bgra.bin.gz > /dev/fb0 2>/dev/null || true
	fi
	echo "Z96A $(cut -d" " -f1 /proc/uptime) card-ready logo-painted" >> /run/initramfs/z96a-anim.log

	echo "Z96A $(cut -d" " -f1 /proc/uptime) daemon-start" >> /run/initramfs/z96a-anim.log
	/usr/sbin/plymouthd --mode=boot --attach-to-session --pid-file=/run/plymouth/pid
	echo "Z96A $(cut -d" " -f1 /proc/uptime) daemon-returned" >> /run/initramfs/z96a-anim.log
	/usr/bin/plymouth --show-splash
	echo "Z96A $(cut -d" " -f1 /proc/uptime) splash-shown" >> /run/initramfs/z96a-anim.log
fi
