+
+void Panel::UpdatePowerStatus(bool force)
+{
+	if (mode != Mode_Lock || !powerfont)
+		return;
+
+	char path[256];
+	const char *runtime = getenv("XDG_RUNTIME_DIR");
+	if (runtime && *runtime)
+		snprintf(path, sizeof(path), "%s/z96a-power/status", runtime);
+	else
+		snprintf(path, sizeof(path), "/run/user/%u/z96a-power/status", (unsigned)getuid());
+
+	map<string, string> values;
+	ifstream input(path);
+	string line;
+	while (getline(input, line)) {
+		size_t pos = line.find('=');
+		if (pos != string::npos)
+			values[line.substr(0, pos)] = line.substr(pos + 1);
+	}
+
+	string source = values.count("POWER_SOURCE") ? values["POWER_SOURCE"] : "UNKNOWN";
+	string btstat = values.count("BATTERY_STATUS") ? values["BATTERY_STATUS"] : "Unknown";
+	string policy = values.count("POLICY_STATE") ? values["POLICY_STATE"] : "WAITING";
+	int present = values.count("BATTERY_PRESENT") ? atoi(values["BATTERY_PRESENT"].c_str()) : -1;
+	int percent = values.count("BATTERY_PERCENT") ? atoi(values["BATTERY_PERCENT"].c_str()) : -1;
+	int remain = values.count("SUSPEND_REMAINING") ? atoi(values["SUSPEND_REMAINING"].c_str()) : -1;
+	int critical_remaining = values.count("CRITICAL_REMAINING") ? atoi(values["CRITICAL_REMAINING"].c_str()) : -1;
+
+	string source_text = source == "AC" ? "交流电" : (source == "BATTERY" ? "电池" : "电源未知");
+	string btstat_text = "状态未知";
+	if (btstat == "Charging") btstat_text = "充电中";
+	else if (btstat == "Discharging") btstat_text = "放电中";
+	else if (btstat == "Full") btstat_text = "已充满";
+	else if (btstat == "Not charging") btstat_text = "未充电";
+
+	ostringstream text;
+	text << source_text;
+	if (present == 0)
+		text << " · 未检测到电池";
+	else if (present < 0)
+		text << " · 电池状态未知";
+	else if (percent >= 0)
+		text << " · 电量 " << percent << "% · " << btstat_text;
+	if (policy == "CRITICAL")
+		text << " · 即将关机 ";
+	if (policy == "CRITICAL" && critical_remaining >= 0) {
+		char critical_clock[32];
+		snprintf(critical_clock, sizeof(critical_clock), "%02d:%02d", critical_remaining / 60, critical_remaining % 60);
+		text << critical_clock;
+	} else if (policy == "CRITICAL") {
+		text << "等待确认";
+	} else if (policy == "LOW_BATTERY")
+		text << " · 自动挂起已禁用";
+	else if (policy == "ERROR")
+		text << " · 电源策略错误";
+	else if (remain < 0)
+		text << " · 挂起已禁用";
+	else {
+		char clock[32];
+		if (remain >= 3600)
+			snprintf(clock, sizeof(clock), "%d:%02d:%02d", remain / 3600, (remain / 60) % 60, remain % 60);
+		else
+			snprintf(clock, sizeof(clock), "%02d:%02d", remain / 60, remain % 60);
+		text << " · 挂起 " << clock;
+	}
+
+	string next = text.str();
+	if (!force && next == power_status_text)
+		return;
+
+	XClearArea(Dpy, Root, power_extents.x, power_extents.y,
+		power_extents.width + 4, power_extents.height + 4, false);
+	XftDraw *draw = XftDrawCreate(Dpy, Root,
+		DefaultVisual(Dpy, Scr), DefaultColormap(Dpy, Scr));
+	XftTextExtents8(Dpy, powerfont, reinterpret_cast<const XftChar8*>(next.c_str()),
+		next.length(), &power_extents);
+	power_x = Cfg::absolutepos(cfg->getOption("power_status_x"), viewport.width, power_extents.width);
+	power_y = Cfg::absolutepos(cfg->getOption("power_status_y"), viewport.height, power_extents.height);
+	power_extents.x = power_x;
+	power_extents.y = power_y - power_extents.height;
+	SlimDrawString8(draw, &powercolor, powerfont, power_x, power_y, next,
+		&powershadowcolor, power_shadow_xoffset, power_shadow_yoffset);
+	power_extents_valid = true;
+	power_status_text = next;
+	XFlush(Dpy);
+	XftDrawDestroy(draw);
 }
 
