 static BOOL dpms_state, using_dpms;
 
 static int term;	// Used by a C callback function
+static char lock_ready_path[256];
 
+static void make_lock_ready_path(void)
+{
+	const char *runtime = getenv("XDG_RUNTIME_DIR");
+	if (runtime && *runtime)
+		snprintf(lock_ready_path, sizeof(lock_ready_path),
+			"%s/z96a-power/lock-ready", runtime);
+	else
+		snprintf(lock_ready_path, sizeof(lock_ready_path),
+			"/run/user/%u/z96a-power/lock-ready", (unsigned)getuid());
+}
 
+static void write_lock_ready(void)
+{
+	char tmp[280];
+	FILE *fp;
+	if (!lock_ready_path[0])
+		make_lock_ready_path();
+	snprintf(tmp, sizeof(tmp), "%s.tmp.%u", lock_ready_path, (unsigned)getpid());
+	fp = fopen(tmp, "w");
+	if (!fp)
+		return;
+	fprintf(fp, "%u\n", (unsigned)getpid());
+	fclose(fp);
+	if (rename(tmp, lock_ready_path) != 0)
+		unlink(tmp);
+}
+
+static void remove_lock_ready(void)
+{
+	if (!lock_ready_path[0])
+		make_lock_ready_path();
+	unlink(lock_ready_path);
+}
