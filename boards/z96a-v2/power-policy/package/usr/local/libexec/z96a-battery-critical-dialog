#!/usr/bin/python3
import argparse
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib

EXIT_SHUTDOWN = 0
EXIT_ERROR = 1
EXIT_CONTINUE = 2


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--percent", type=int, required=True)
    parser.add_argument("--timeout", type=int, default=60)
    args = parser.parse_args()

    remaining = max(1, args.timeout)
    dialog = Gtk.Dialog(title="电池电量严重不足")
    dialog.set_default_size(520, 220)
    dialog.set_resizable(False)
    dialog.set_modal(True)
    dialog.set_keep_above(True)
    dialog.set_position(Gtk.WindowPosition.CENTER_ALWAYS)
    dialog.set_urgency_hint(True)
    dialog.add_button("立即关机", 1)
    dialog.add_button("强制继续使用", 2)
    dialog.set_default_response(2)

    label = Gtk.Label()
    label.set_line_wrap(True)
    label.set_justify(Gtk.Justification.CENTER)
    label.set_margin_top(24)
    label.set_margin_bottom(24)
    label.set_margin_start(24)
    label.set_margin_end(24)
    dialog.get_content_area().add(label)

    def update_label():
        label.set_markup(
            "<span size='x-large' weight='bold'>电池仅剩 %d%%</span>\n\n"
            "<span size='large'>系统将在 <b>%d 秒</b>后自动关机。</span>\n\n"
            "请连接电源，或选择“强制继续使用”。" % (args.percent, remaining)
        )

    def tick():
        nonlocal remaining
        remaining -= 1
        if remaining <= 0:
            dialog.response(1)
            return False
        update_label()
        return True

    def on_delete_event(_dialog, _event):
        # The user must explicitly choose one of the two actions.
        return True

    dialog.connect("delete-event", on_delete_event)
    update_label()
    dialog.show_all()
    dialog.present()
    GLib.timeout_add_seconds(1, tick)
    response = dialog.run()
    dialog.destroy()
    if response == 1:
        return EXIT_SHUTDOWN
    if response == 2:
        return EXIT_CONTINUE
    return EXIT_ERROR


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        print("z96a-battery-critical-dialog: %s" % exc, file=sys.stderr)
        sys.exit(EXIT_ERROR)
